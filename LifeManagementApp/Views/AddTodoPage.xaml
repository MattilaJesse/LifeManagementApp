<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             xmlns:models="clr-namespace:LifeManagementApp.Models"
             x:Class="LifeManagementApp.Views.AddTodoPage"
             x:DataType="vm:AddTodoViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="{Binding PageTitle}"
                   FontSize="22"
                   FontAttributes="Bold" />

            <!-- Validointivirhe (tyhjä otsikko) -->
            <Label Text="{Binding ValidationError}"
                   TextColor="Crimson"
                   FontAttributes="Bold"
                   IsVisible="{Binding HasValidationError}" />

            <Label Text="Otsikko *" FontAttributes="Bold" />
            <Entry Placeholder="Kirjoita tehtävän otsikko..."
                   Text="{Binding Title}" />

            <Label Text="Lisätiedot" FontAttributes="Bold" />
            <Editor Placeholder="Vapaaehtoiset muistiinpanot..."
                    HeightRequest="80"
                    Text="{Binding Notes}" />

            <Label Text="Kategoria" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Categories}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedCategory}" />

            <Label Text="{Binding Priority, StringFormat='Prioriteetti: {0} (1 = matala, 5 = kiireellinen)'}"
                   FontAttributes="Bold" />
            <Stepper Minimum="1"
                     Maximum="5"
                     Increment="1"
                     Value="{Binding Priority}" />

            <Label Text="Eräpäivä" FontAttributes="Bold" />
            <DatePicker Date="{Binding DueDate}" />

            <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                <Button Text="Tallenna"
                        Command="{Binding SaveCommand}" />
                <Button Text="Peruuta"
                        BackgroundColor="Gray"
                        Command="{Binding CancelCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>