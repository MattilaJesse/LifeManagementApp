<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             xmlns:models="clr-namespace:LifeManagementApp.Models"
             xmlns:conv="clr-namespace:LifeManagementApp.Converters"
             x:Class="LifeManagementApp.Views.TodoListPage"
             x:DataType="vm:TodoListViewModel"
             Title="Tehtävät">

    <ContentPage.Resources>
        <conv:PriorityToColorConverter x:Key="PriorityColorConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- Yläpalkki: Lajittelu ja Uusi tehtävä -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Button Text="Järjestä: Prioriteetti"
                    Command="{Binding SortByPriorityCommand}" />
            <Button Text="Järjestä: Eräpäivä"
                    Command="{Binding SortByDueDateCommand}" />
            <Button Text="+ Uusi"
                    Command="{Binding GoToAddTodoCommand}" />
        </HorizontalStackLayout>

        <!-- Tehtävälista -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Todos}"
                        EmptyView="Ei tehtäviä. Lisää ensimmäinen + Uusi -napista!">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <SwipeView Margin="0,0,0,8">
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Poista"
                                           BackgroundColor="Crimson"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=DeleteTodoCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border StrokeShape="RoundRectangle 10"
                                Padding="12"
                                StrokeThickness="1">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                <!-- Tehty-valintaruutu -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsDone}"
                                          CheckedChanged="OnTodoCheckBoxChanged" />

                                <!-- Prioriteettiväri -->
                                <BoxView Grid.Column="1"
                                         WidthRequest="12"
                                         HeightRequest="12"
                                         CornerRadius="6"
                                         VerticalOptions="Center"
                                         Color="{Binding Priority, Converter={StaticResource PriorityColorConverter}}" />

                                <!-- Otsikko, muistiinpanot ja kategoria -->
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="{Binding Title}"
                                           FontSize="16"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Notes}"
                                           FontSize="13"
                                           TextColor="Gray"
                                           IsVisible="{Binding Notes, Converter={x:Null}, TargetNullValue=False}" />
                                    <Label Text="{Binding Category.Name}"
                                           FontSize="12"
                                           TextColor="Gray" />
                                </VerticalStackLayout>

                                <!-- Prioriteetti ja eräpäivä -->
                                <VerticalStackLayout Grid.Column="3" HorizontalOptions="End" VerticalOptions="Center">
                                    <Label Text="{Binding Priority, StringFormat='Prio {0}'}"
                                           FontAttributes="Bold"
                                           HorizontalOptions="End" />
                                    <Label Text="{Binding DueDate, StringFormat='{0:dd.MM.yyyy}'}"
                                           FontSize="12"
                                           TextColor="Gray" />
                                </VerticalStackLayout>

                                <!-- Muokkaus- ja poistonapit (helppo käyttää myös Windowsilla hiirellä) -->
                                <HorizontalStackLayout Grid.Column="4" Spacing="4" VerticalOptions="Center">
                                    <Button Text="Muokkaa"
                                            FontSize="12"
                                            Padding="8,4"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=GoToEditTodoCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="X"
                                            FontSize="12"
                                            Padding="8,4"
                                            BackgroundColor="Crimson"
                                            TextColor="White"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=DeleteTodoCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>